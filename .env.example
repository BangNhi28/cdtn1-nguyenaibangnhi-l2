PORT=3001
NODE_ENV=development

# SQLite khi chưa điền MYSQL_PASSWORD (test luôn dùng SQLite :memory:)
DATABASE_PATH=./data/smartcrm.sqlite

# Optional: whitelist CORS (comma-separated). Để trống nếu UI cùng origin :3001
# CORS_ORIGINS=http://localhost:5173

# Đặt 1 khi chạy sau reverse proxy TLS (đọc X-Forwarded-Proto)
# TRUST_PROXY=0

# Aiven MySQL — điền MYSQL_PASSWORD rồi chạy npm run migrate && npm run seed && npm start
MYSQL_HOST=cdtn1-mysql-******************.g.aivencloud.com
MYSQL_PORT=19451
MYSQL_USER=avnadmin
MYSQL_PASSWORD=*****************
MYSQL_DATABASE= your db 
