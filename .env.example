# Aiven for MySQL (free tier). Lấy giá trị thật trên Aiven Console > Overview > Connection information.
# Không ghi mật khẩu thật vào Git. Copy file này thành .env rồi điền.

MYSQL_HOST=your-service.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=defaultdb
MYSQL_SSL_MODE=REQUIRED
