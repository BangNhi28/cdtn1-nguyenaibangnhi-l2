        <mxCell id="L3txt" parent="L3" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" value="customer.repository.js · device.repository.js · ticket.repository.js · ticketStatusLog.repository.js&lt;br&gt;issueCategory.repository.js · user.repository.js&lt;br&gt;src/db.js — pool MySQL (mysql2) hoặc wrapper SQLite (node:sqlite)&lt;br&gt;&lt;i&gt;SQL thuần; không quy tắc nghiệp vụ&lt;/i&gt;" vertex="1">
