        <mxCell id="L1txt" parent="L1" style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" value="&lt;b&gt;Entry:&lt;/b&gt; src/server.js → src/app.js (createApp)&lt;br&gt;• routes/auth.routes.js — POST /api/login&lt;br&gt;• routes/customers.routes.js — /api/customers (tra cứu phone, CRUD)&lt;br&gt;• routes/tickets.routes.js — /api/tickets, phân loại, ưu tiên, status-log&lt;br&gt;• middleware/auth.js — requireAuth, requireRole(NHAN_VIEN cho tạo/sửa phiếu)&lt;br&gt;• utils/asyncHandler.js · &lt;i&gt;Không chứa quy tắc QT; chỉ nhận request / trả JSON&lt;/i&gt;" vertex="1">
